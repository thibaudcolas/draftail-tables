{
  "name": "draftail-tables",
  "version": "1.0.0",
  "description": "📝🧾 Tables support for the Draftail Draft.js editor",
  "author": "Thibaud Colas",
  "license": "MIT",
  "main": "dist/draftail-tables.cjs.js",
  "module": "dist/draftail-tables.esm.js",
  "flow": "dist/draftail-tables.cjs.js.flow",
  "sideEffects": false,
  "keywords": [
    "draftjs",
    "draft-js",
    "editor",
    "react",
    "wysiwyg",
    "rich text",
    "richtext",
    "rte",
    "tables"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thibaudcolas/draftail-tables.git"
  },
  "bugs": {
    "url": "https://github.com/thibaudcolas/draftail-tables/issues"
  },
  "homepage": "https://thibaudcolas.github.io/draftail-tables/",
  "files": [
    "dist/*.js",
    "dist/*.flow",
    "dist/*.css",
    "dist/flow/**/*.js"
  ],
  "browserslist": {
    "production": [
      ">1%",
      "not dead",
      "not op_mini all",
      "not IE 11"
    ],
    "development": [
      ">1%",
      "not dead",
      "not op_mini all",
      "not IE 11"
    ]
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.9",
    "@babel/preset-flow": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@vitest/coverage-v8": "5.0.1",
    "draft-js": "0.10.5",
    "draftail": "2.0.0",
    "enzyme": "3.11.0",
    "enzyme-adapter-react-16": "1.15.8",
    "enzyme-to-json": "3.6.2",
    "eslint": "9.39.5",
    "immutable": "~3.7.6",
    "jsdom": "20.0.3",
    "postcss": "8.5.28",
    "postcss-normalize": "13.0.1",
    "postcss-scss": "4.0.9",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "react-test-renderer": "16.14.0",
    "sass": "1.105.1",
    "stylelint": "17.16.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "draft-js": "^0.10.5",
    "react": "^16.0.0"
  },
  "scripts": {
    "dev": "vp dev",
    "start": "vp dev",
    "build": "vp build && vp pack && node tooling/flow-types.mjs",
    "preview": "vp preview",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage.enabled",
    "test:watch": "vp test watch",
    "report:coverage": "xdg-open coverage/index.html",
    "report:package": "npm pack --dry-run",
    "lint": "vp check && eslint src && stylelint \"src/**/*.scss\"",
    "format": "vp fmt",
    "test:ci": "npm run lint && npm run build && npm run test:coverage",
    "prepare": "vp config --no-agent",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": "^22.18.0 || >=24.10.0"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1",
    "isomorphic-fetch": {
      "node-fetch": "^2.0.0"
    }
  }
}
