{
  extends: ["config:recommended"],
  labels: ["enhancement"],
  schedule: ["every weekend"],
  packageRules: [
    {
      matchPackageNames: ["draft-js", "draftail", "immutable"],
      enabled: false,
    },
    {
      matchPackageNames: ["react", "react-dom", "react-test-renderer"],
      allowedVersions: "16.x",
      groupName: "react",
    },
    {
      // Enzyme needs Cheerio's legacy CommonJS API; jsdom 20 permits the
      // existing location mock used by the error-boundary tests.
      matchPackageNames: ["cheerio", "jsdom"],
      enabled: false,
    },
    {
      matchPackageNames: ["vite", "vite-plus", "vitest", "@vitest/coverage-v8"],
      groupName: "vite-plus",
    },
  ],
}
